    <RootNamespace>Orchid.Core</RootNamespace>
    <AssemblyName>Orchid.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);test\**</DefaultItemExcludes>
